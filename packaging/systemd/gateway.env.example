# Copy to /etc/industrial_iot_gateway/gateway.env and replace the serial path.
# Prefer /dev/serial/by-id/... on real hardware; do not freeze /dev/ttyUSB0.
GATEWAY_SERIAL_DEVICE=/dev/serial/by-id/REPLACE_ME
GATEWAY_REGISTER_MAP=/etc/industrial_iot_gateway/register_map.yaml

# Leave empty for serial-only operation. To enable the local anonymous MQTT
# development profile, keep all three options together, for example:
# GATEWAY_MQTT_ARGS=--mqtt-broker-uri tcp://127.0.0.1:1883 --mqtt-client-id industrial-iot-gateway --gateway-id gateway-demo
GATEWAY_MQTT_ARGS=

# This file intentionally contains no production credentials or TLS material.
# Use a separately permissioned deployment-specific environment file for them.
